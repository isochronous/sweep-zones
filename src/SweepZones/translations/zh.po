#. STRINGS.UI.TOOLS.FILTERLAYERS.SWEEPZONES_MOP.NAME
msgctxt "STRINGS.UI.TOOLS.FILTERLAYERS.SWEEPZONES_MOP.NAME"
msgid "Mop zone"
msgstr "擦拭区域"

#. STRINGS.UI.TOOLS.FILTERLAYERS.SWEEPZONES_MOP.TOOLTIP
msgctxt "STRINGS.UI.TOOLS.FILTERLAYERS.SWEEPZONES_MOP.TOOLTIP"
msgid "Moppable puddles inside the zone continuously receive mop errands at the selected priority"
msgstr "区域内可擦拭的积液会持续以所选优先度接到擦拭任务"

#. STRINGS.UI.TOOLS.FILTERLAYERS.SWEEPZONES_MOP_CLEAR.NAME
msgctxt "STRINGS.UI.TOOLS.FILTERLAYERS.SWEEPZONES_MOP_CLEAR.NAME"
msgid "Erase mop zone"
msgstr "擦除擦拭区域"

#. STRINGS.UI.TOOLS.FILTERLAYERS.SWEEPZONES_MOP_CLEAR.TOOLTIP
msgctxt "STRINGS.UI.TOOLS.FILTERLAYERS.SWEEPZONES_MOP_CLEAR.TOOLTIP"
msgid "Remove mop zone cells (existing mop errands are kept)"
msgstr "移除擦拭区域格子（已有的擦拭任务保留）"

#. STRINGS.UI.TOOLS.FILTERLAYERS.SWEEPZONES_SWEEP.NAME
msgctxt "STRINGS.UI.TOOLS.FILTERLAYERS.SWEEPZONES_SWEEP.NAME"
msgid "Sweep zone"
msgstr "清扫区域"

#. STRINGS.UI.TOOLS.FILTERLAYERS.SWEEPZONES_SWEEP.TOOLTIP
msgctxt "STRINGS.UI.TOOLS.FILTERLAYERS.SWEEPZONES_SWEEP.TOOLTIP"
msgid "Debris inside the zone is continuously marked for sweeping at the selected priority"
msgstr "区域内的碎片会持续以所选优先度标记为清扫"

#. STRINGS.UI.TOOLS.FILTERLAYERS.SWEEPZONES_SWEEP_CLEAR.NAME
msgctxt "STRINGS.UI.TOOLS.FILTERLAYERS.SWEEPZONES_SWEEP_CLEAR.NAME"
msgid "Erase sweep zone"
msgstr "擦除清扫区域"

#. STRINGS.UI.TOOLS.FILTERLAYERS.SWEEPZONES_SWEEP_CLEAR.TOOLTIP
msgctxt "STRINGS.UI.TOOLS.FILTERLAYERS.SWEEPZONES_SWEEP_CLEAR.TOOLTIP"
msgid "Remove sweep zone cells (existing sweep errands are kept)"
msgstr "移除清扫区域格子（已有的清扫任务保留）"

#. STRINGS.UI.TOOLS.SWEEPZONES.ACTION_ERASE_MOP
msgctxt "STRINGS.UI.TOOLS.SWEEPZONES.ACTION_ERASE_MOP"
msgid "ERASE MOP ZONE"
msgstr "擦除擦拭区域"

#. STRINGS.UI.TOOLS.SWEEPZONES.ACTION_ERASE_SWEEP
msgctxt "STRINGS.UI.TOOLS.SWEEPZONES.ACTION_ERASE_SWEEP"
msgid "ERASE SWEEP ZONE"
msgstr "擦除清扫区域"

#. STRINGS.UI.TOOLS.SWEEPZONES.ACTION_PAINT_MOP
msgctxt "STRINGS.UI.TOOLS.SWEEPZONES.ACTION_PAINT_MOP"
msgid "PAINT MOP ZONE"
msgstr "绘制擦拭区域"

#. STRINGS.UI.TOOLS.SWEEPZONES.ACTION_PAINT_SWEEP
msgctxt "STRINGS.UI.TOOLS.SWEEPZONES.ACTION_PAINT_SWEEP"
msgid "PAINT SWEEP ZONE"
msgstr "绘制清扫区域"

#. STRINGS.UI.TOOLS.SWEEPZONES.NAME
msgctxt "STRINGS.UI.TOOLS.SWEEPZONES.NAME"
msgid "Sweep Zones"
msgstr "清扫区域"

#. STRINGS.UI.TOOLS.SWEEPZONES.TOOLNAME
msgctxt "STRINGS.UI.TOOLS.SWEEPZONES.TOOLNAME"
msgid "Sweep Zones tool"
msgstr "清扫区域工具"

#. STRINGS.UI.TOOLS.SWEEPZONES.TOOLTIP
msgctxt "STRINGS.UI.TOOLS.SWEEPZONES.TOOLTIP"
msgid "Paint zones where debris is automatically marked for sweeping and puddles for mopping"
msgstr "绘制区域，区域内的碎片会自动标记为清扫，积液会自动标记为擦拭"
